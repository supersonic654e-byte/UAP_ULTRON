    subgraph L3["LAYER 3 — PILOT CLOUD (V0.3 laptop; Cloud/Command Centre on InsightV1.0)"]
        N1[Nav2: costmaps, planner, controller]
        N2[slam_toolbox mapping / AMCL localization]
        N3[EKF robot_localization  P1 move to Jetson]
        N4[RViz2 supervision]
        N5[rosbag2 mcap: /odom /scan /kinect/scan /battery/state /ultron/*]
        N6[feature_extract.py -> anonymous motion features]
        N7[/diagnostics consumer]
    end

    subgraph L2["LAYER 2 — EDGE (Jetson Nano 4 GB now -> Orin Nano Super 8 GB)"]
        E1[rplidar_ros -> /scan]
        E2[ultron_kinect (Kinect 1414, ROI 320x120 @8FPS)]
        E3[ultron_depth_to_scan -> /kinect/scan  camera_info-driven P1]
        E4[ultron_safety_node -> /safe_cmd_vel, /ultron/heartbeat]
        E5[ultron_serial_node -> /odom, /imu/data, /battery/state, /ultron/fault]
        E6[ultron_data_logger -> /mnt/ssd/ultron/logs (Section 17)]
        E7[static TFs: base->laser/kinect/imu]
    end

